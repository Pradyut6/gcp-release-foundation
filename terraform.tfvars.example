publisher_account   = "image-publisher@example-delivery.iam.gserviceaccount.com"

environments = {
  staging = {
    project_id         = "example-staging"
    execution_account  = "staging-exec@example-delivery.iam.gserviceaccount.com"
    image_pull_account = "service-123456789012@serverless-robot-prod.iam.gserviceaccount.com"
  }
  production = {
    project_id         = "example-production"
    execution_account  = "production-exec@example-delivery.iam.gserviceaccount.com"
    image_pull_account = "service-123456789013@serverless-robot-prod.iam.gserviceaccount.com"
  }
}
